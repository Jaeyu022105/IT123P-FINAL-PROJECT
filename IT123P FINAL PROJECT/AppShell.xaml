<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IT123P_FINAL_PROJECT.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:IT123P_FINAL_PROJECT"
    xmlns:views="clr-namespace:IT123P_FINAL_PROJECT.Views"
    Title="FoodLens"
    BackgroundColor="{StaticResource Canvas}"
    Shell.BackgroundColor="{StaticResource Surface}"
    Shell.ForegroundColor="{StaticResource Forest}"
    Shell.TitleColor="{StaticResource Forest}"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Forest}"
    Shell.TabBarUnselectedColor="{StaticResource TextMuted}">

    <TabBar>
        <Tab Title="Home" Icon="home_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:DietSummaryPage}" Route="DietSummaryPage" />
        </Tab>
        <Tab Title="History" Icon="history_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryPage}" Route="HistoryPage" />
        </Tab>
        <Tab Title="Log Food" Icon="camera_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:CameraPage}" Route="CameraPage" />
        </Tab>
        <Tab Title="Settings" Icon="settings_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
