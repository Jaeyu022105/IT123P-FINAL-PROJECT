<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:IT123P_FINAL_PROJECT.ViewModels"
             x:Class="IT123P_FINAL_PROJECT.Views.SettingsPage"
             x:DataType="viewmodels.SettingsViewModel"
             Title="Settings"
             BackgroundColor="{StaticResource Canvas}">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" StrokeThickness="0" BackgroundColor="{StaticResource Surface}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label Text="Settings &amp; Goals" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Plum}" />
                <Label Text="Configure your daily targets" FontSize="12" TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Border>

        <!-- Main Form (Scrollable) -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="20">
                
                <!-- Diet Goal Settings -->
                <Border StrokeThickness="0" Padding="20" BackgroundColor="{StaticResource Surface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        <Label Text="DAILY NUTRITION TARGETS" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                        
                        <!-- Calorie Input -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Calorie Limit (kcal)" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Entry Keyboard="Numeric" Text="{Binding CalorieLimit}" BackgroundColor="{StaticResource Canvas}" FontSize="14" HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Macro Target Headers -->
                        <Label Text="Macronutrient Split (%)" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,5,0,0" />

                        <!-- Protein Input -->
                        <Grid ColumnDefinitions="*, 80" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Protein Target" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding ProteinPercentage}" BackgroundColor="{StaticResource Canvas}" FontSize="14" HorizontalTextAlignment="Center" HeightRequest="38" />
                        </Grid>

                        <!-- Carbs Input -->
                        <Grid ColumnDefinitions="*, 80" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Carbohydrates Target" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding CarbsPercentage}" BackgroundColor="{StaticResource Canvas}" FontSize="14" HorizontalTextAlignment="Center" HeightRequest="38" />
                        </Grid>

                        <!-- Fat Input -->
                        <Grid ColumnDefinitions="*, 80" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Fat Target" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding FatPercentage}" BackgroundColor="{StaticResource Canvas}" FontSize="14" HorizontalTextAlignment="Center" HeightRequest="38" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Macro Splits Presets -->
                <Border StrokeThickness="0" Padding="20" BackgroundColor="{StaticResource Surface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MACRO RATIO PRESETS" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                        
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,5,0,0">
                            <Button Grid.Column="0" Text="Balanced" BackgroundColor="{StaticResource Canvas}" TextColor="{StaticResource Plum}" CornerRadius="8" HeightRequest="45" Padding="0" FontSize="11" Command="{Binding ApplyPresetCommand}" CommandParameter="balanced" />
                            <Button Grid.Column="1" Text="High Protein" BackgroundColor="{StaticResource Canvas}" TextColor="{StaticResource Plum}" CornerRadius="8" HeightRequest="45" Padding="0" FontSize="11" Command="{Binding ApplyPresetCommand}" CommandParameter="highprotein" />
                            <Button Grid.Column="2" Text="Low Carb" BackgroundColor="{StaticResource Canvas}" TextColor="{StaticResource Plum}" CornerRadius="8" HeightRequest="45" Padding="0" FontSize="11" Command="{Binding ApplyPresetCommand}" CommandParameter="lowcarb" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Legacy Integration (SOAP) -->
                <Border StrokeThickness="0" Padding="20" BackgroundColor="{StaticResource Surface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="LEGACY DATA EXPORT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                        <Label Text="Export your daily diet summaries to external SOAP/XML-based clinical databases (e.g. dietitian clinical systems)." FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Button Text="Export logs (Phase 5)" BackgroundColor="{StaticResource Canvas}" TextColor="{StaticResource TextMuted}" CornerRadius="8" HeightRequest="40" Margin="0,5,0,0" IsEnabled="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- Status Banner (Visible on Success/Failure) -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    
                    <!-- Validation Error Message -->
                    <Label Text="{Binding ValidationMessage}" 
                           TextColor="{StaticResource Danger}"
                           FontSize="13" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center"
                           Margin="10,0" />

                    <!-- Success Message -->
                    <Label Text="Goal targets updated successfully! &#x2713;"
                           TextColor="{StaticResource Forest}"
                           FontSize="14" 
                           FontAttributes="Bold" 
                           IsVisible="{Binding IsSuccess}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save Button -->
        <Grid Grid.Row="2" Padding="20,10,20,20" BackgroundColor="{StaticResource Surface}">
            <Button Text="Save Targets" BackgroundColor="{StaticResource Berry}" TextColor="{StaticResource Surface}" CornerRadius="12" HeightRequest="50" FontAttributes="Bold" Command="{Binding SaveGoalCommand}" />
        </Grid>

    </Grid>
</ContentPage>
