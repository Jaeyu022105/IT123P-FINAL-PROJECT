<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:IT123P_FINAL_PROJECT.ViewModels"
             xmlns:models="clr-namespace:IT123P_FINAL_PROJECT.Models"
             x:Class="IT123P_FINAL_PROJECT.Views.CameraPage"
             x:DataType="viewmodels:CameraViewModel"
             Title="Log Food"
             BackgroundColor="{StaticResource Canvas}">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" StrokeThickness="0" BackgroundColor="{StaticResource Surface}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label Text="Identify Food" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Plum}" />
                <Label Text="Snap a photo or type manually" FontSize="12" TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" RowDefinitions="*, Auto" RowSpacing="15" Padding="20">
            
            <!-- Camera Simulation Box or Candidate List -->
            <Grid Grid.Row="0">
                <!-- Camera viewfinder placeholder (Only visible if NOT showing candidates) -->
                <Border StrokeThickness="0" BackgroundColor="{StaticResource Viewfinder}" Margin="0,0,0,10" IsVisible="{Binding ShowViewfinder}" HeightRequest="320" VerticalOptions="FillAndExpand">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="*, Auto">
                        <!-- Simulated Camera View -->
                        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                            <Image Source="camera_icon.png" HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                            <Label Text="Camera Viewfinder Active" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PlumLight}" HorizontalOptions="Center" />
                            <Label Text="Point camera at your meal and tap Capture" FontSize="12" TextColor="{StaticResource Sage}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <!-- Actions overlay on viewfinder -->
                        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,0,0,20">
                            <Button Text="Gallery" BackgroundColor="{StaticResource Glass}" TextColor="{StaticResource Surface}" CornerRadius="18" WidthRequest="110" Command="{Binding PickFromGalleryCommand}" />
                            <Button Text="Snap Photo" BackgroundColor="{StaticResource Berry}" TextColor="{StaticResource Surface}" CornerRadius="18" WidthRequest="140" FontAttributes="Bold" Command="{Binding CapturePhotoCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Recognition Results Cards (Only visible if showing candidates) -->
                <ScrollView IsVisible="{Binding ShowCandidates}" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Recognized Food Candidates" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" Margin="0,5,0,0" />
                        
                        <!-- Captured Image Preview -->
                        <Border StrokeThickness="0" HeightRequest="180" BackgroundColor="{StaticResource PlumLight}" Margin="0,0,0,5" HorizontalOptions="FillAndExpand">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Image Source="{Binding CapturedImageSource}" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                        </Border>
                        
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Candidates}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:FoodCandidate">
                                    <Border StrokeThickness="0" Padding="16,14" BackgroundColor="{StaticResource Surface}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding ConfidenceText}" FontSize="11" TextColor="{StaticResource Plum}" FontAttributes="Bold" />
                                                <Label Text="{Binding CaloriesPer100g, StringFormat='Base Nutrition: {0:F0} kcal per 100g'}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Select" BackgroundColor="{StaticResource Plum}" TextColor="{StaticResource Surface}" CornerRadius="10" HeightRequest="36" Padding="15,0" VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CameraViewModel}}, Path=SelectCandidateCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Back to camera -->
                        <Button Text="&#x2190; Back to Camera View" BackgroundColor="Transparent" TextColor="{StaticResource Plum}" FontAttributes="Bold" HeightRequest="45" Margin="0,10,0,0" Command="{Binding PickFromGalleryCommand}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- Manual Search Panel (Always at the bottom of the work area) -->
            <Border Grid.Row="1" StrokeThickness="0" Padding="16" BackgroundColor="{StaticResource Surface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Or Search Manually" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="Type food name (e.g. Rice, Oats...)" Text="{Binding SearchQuery}" BackgroundColor="{StaticResource Canvas}" PlaceholderColor="{StaticResource TextSubtle}" FontSize="14" HeightRequest="42" ClearButtonVisibility="WhileEditing" />
                        <Button Grid.Column="1" Text="Search" BackgroundColor="{StaticResource Leaf}" TextColor="{StaticResource Surface}" CornerRadius="8" HeightRequest="42" Padding="20,0" FontAttributes="Bold" Command="{Binding ManualSearchCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Loading Overlay (Visible during analysis) -->
        <Grid Grid.RowSpan="3" BackgroundColor="{StaticResource Overlay}" IsVisible="{Binding IsBusy}">
            <Border StrokeThickness="0" Padding="30,24" BackgroundColor="{StaticResource Surface}" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Plum}" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
