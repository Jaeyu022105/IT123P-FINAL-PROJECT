<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:IT123P_FINAL_PROJECT.ViewModels"
             xmlns:models="clr-namespace:IT123P_FINAL_PROJECT.Models"
             x:Class="IT123P_FINAL_PROJECT.Views.CameraPage"
             x:DataType="viewmodels.CameraViewModel"
             Title="Log Food"
             BackgroundColor="#F5F5FA">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" StrokeThickness="0" BackgroundColor="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label Text="Identify Food" FontSize="22" FontAttributes="Bold" TextColor="#6C4AB6" />
                <Label Text="Snap a photo or type manually" FontSize="12" TextColor="#7E7E8F" />
            </VerticalStackLayout>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" RowDefinitions="*, Auto" RowSpacing="15" Padding="20">
            
            <!-- Camera Simulation Box or Candidate List -->
            <Grid Grid.Row="0">
                <!-- Camera viewfinder placeholder (Only visible if NOT showing candidates) -->
                <Border StrokeThickness="0" BackgroundColor="#1E1E24" Margin="0,0,0,10" IsVisible="{Binding ShowViewfinder}" HeightRequest="320" VerticalOptions="FillAndExpand">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="*, Auto">
                        <!-- Simulated Camera View -->
                        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                            <Label Text="📷" FontSize="64" HorizontalOptions="Center" />
                            <Label Text="Camera Viewfinder Active" FontSize="16" FontAttributes="Bold" TextColor="#E2D9F3" HorizontalOptions="Center" />
                            <Label Text="Point camera at your meal and tap Capture" FontSize="12" TextColor="#A799C7" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <!-- Actions overlay on viewfinder -->
                        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,0,0,20">
                            <Button Text="Gallery" BackgroundColor="#33FFFFFF" TextColor="#FFFFFF" CornerRadius="18" WidthRequest="110" Command="{Binding PickFromGalleryCommand}" />
                            <Button Text="Snap Photo" BackgroundColor="#F06292" TextColor="#FFFFFF" CornerRadius="18" WidthRequest="140" FontAttributes="Bold" Command="{Binding CapturePhotoCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Recognition Results Cards (Only visible if showing candidates) -->
                <ScrollView IsVisible="{Binding ShowCandidates}" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Recognized Food Candidates" FontAttributes="Bold" FontSize="15" TextColor="#222222" Margin="0,5,0,0" />
                        
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Candidates}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models.FoodCandidate">
                                    <Border StrokeThickness="0" Padding="16,14" BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#222222" />
                                                <Label Text="{Binding ConfidenceText}" FontSize="11" TextColor="#6C4AB6" FontAttributes="Bold" />
                                                <Label Text="{Binding CaloriesPer100g, StringFormat='Base Nutrition: {0:F0} kcal per 100g'}" FontSize="11" TextColor="#7E7E8F" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Select" BackgroundColor="#6C4AB6" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="36" Padding="15,0" VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CameraViewModel}}, Path=SelectCandidateCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Back to camera -->
                        <Button Text="← Back to Camera View" BackgroundColor="Transparent" TextColor="#6C4AB6" FontAttributes="Bold" HeightRequest="45" Margin="0,10,0,0" Command="{Binding PickFromGalleryCommand}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- Manual Search Panel (Always at the bottom of the work area) -->
            <Border Grid.Row="1" StrokeThickness="0" Padding="16" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Or Search Manually" FontSize="13" FontAttributes="Bold" TextColor="#7E7E8F" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="Type food name (e.g. Rice, Oats...)" Text="{Binding SearchQuery}" BackgroundColor="#F5F5FA" PlaceholderColor="#A3A3B3" FontSize="14" HeightRequest="42" ClearButtonVisibility="WhileEditing" />
                        <Button Grid.Column="1" Text="Search" BackgroundColor="#8D72E1" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="42" Padding="20,0" FontAttributes="Bold" Command="{Binding ManualSearchCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Loading Overlay (Visible during analysis) -->
        <Grid Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="{Binding IsBusy}">
            <Border StrokeThickness="0" Padding="30,24" BackgroundColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#6C4AB6" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}" FontSize="14" FontAttributes="Bold" TextColor="#222222" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
