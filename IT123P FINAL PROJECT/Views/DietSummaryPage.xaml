<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:IT123P_FINAL_PROJECT.ViewModels"
             xmlns:models="clr-namespace:IT123P_FINAL_PROJECT.Models"
             x:Class="IT123P_FINAL_PROJECT.Views.DietSummaryPage"
             x:DataType="viewmodels.DietSummaryViewModel"
             Title="Home"
             BackgroundColor="#F5F5FA">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" Padding="20,15" StrokeThickness="0" BackgroundColor="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label Text="FoodLens" FontSize="26" FontAttributes="Bold" TextColor="#6C4AB6" />
                <Label Text="Track, Analyze &amp; Adjust" FontSize="12" TextColor="#7E7E8F" />
            </VerticalStackLayout>
        </Border>

        <!-- Main Content (Scrollable) -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="20">
                
                <!-- Calorie Card -->
                <Border StrokeThickness="0" Padding="24" HeightRequest="190">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6C4AB6" Offset="0.0"/>
                            <GradientStop Color="#8D72E1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Text="TODAY'S CALORIES" FontSize="11" FontAttributes="Bold" TextColor="#E2D9F3" CharacterSpacing="1" />
                        
                        <HorizontalStackLayout Grid.Row="1" Spacing="5" VerticalOptions="End">
                            <Label Text="{Binding CalorieUsed, StringFormat='{0:F0}'}" FontSize="40" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="{Binding CalorieLimit, StringFormat='/ {0:F0} kcal'}" FontSize="18" TextColor="#D1C4E9" VerticalOptions="Center" Margin="0,0,0,5" />
                        </HorizontalStackLayout>

                        <!-- Progress Bar -->
                        <ProgressBar Grid.Row="2" Progress="{Binding CalorieProgress}" ProgressColor="#F06292" HeightRequest="8" ScaleY="2.0" WidthRequest="280" HorizontalOptions="Start" />

                        <HorizontalStackLayout Grid.Row="3" Spacing="4">
                            <Label Text="{Binding CalorieRemaining, StringFormat='{0:F0}'}" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="kcal remaining today" TextColor="#D1C4E9" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Macro Row (Grid) -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12">
                    
                    <!-- Protein Card -->
                    <Border Grid.Column="0" StrokeThickness="0" Padding="12" BackgroundColor="#FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="PROTEIN" FontSize="10" FontAttributes="Bold" TextColor="#7E7E8F" HorizontalOptions="Center"/>
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding ProteinUsed, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" TextColor="#222222" />
                                <Label Text="{Binding ProteinLimit, StringFormat='/{0:F0}g'}" FontSize="11" TextColor="#888888" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding ProteinProgress}" ProgressColor="#6C4AB6" HeightRequest="4" WidthRequest="60" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Carbs Card -->
                    <Border Grid.Column="1" StrokeThickness="0" Padding="12" BackgroundColor="#FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="CARBS" FontSize="10" FontAttributes="Bold" TextColor="#7E7E8F" HorizontalOptions="Center"/>
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding CarbsUsed, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" TextColor="#222222" />
                                <Label Text="{Binding CarbsLimit, StringFormat='/{0:F0}g'}" FontSize="11" TextColor="#888888" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding CarbsProgress}" ProgressColor="#4CAF50" HeightRequest="4" WidthRequest="60" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Fat Card -->
                    <Border Grid.Column="2" StrokeThickness="0" Padding="12" BackgroundColor="#FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="FAT" FontSize="10" FontAttributes="Bold" TextColor="#7E7E8F" HorizontalOptions="Center"/>
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding FatUsed, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" TextColor="#222222" />
                                <Label Text="{Binding FatLimit, StringFormat='/{0:F0}g'}" FontSize="11" TextColor="#888888" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding FatProgress}" ProgressColor="#FF9800" HeightRequest="4" WidthRequest="60" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Food Log List Title -->
                <Label Text="Today's Logged Meals" FontSize="16" FontAttributes="Bold" TextColor="#222222" Margin="0,10,0,0" />

                <!-- Logged Meals List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding LoggedMeals}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models.FoodLogEntry">
                            <Border StrokeThickness="0" Padding="14,10" BackgroundColor="#FFFFFF">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding FoodName}" FontSize="14" FontAttributes="Bold" TextColor="#222222" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Grams, StringFormat='{0:F0}g'}" FontSize="11" TextColor="#7E7E8F" />
                                            <Label Text="•" FontSize="11" TextColor="#7E7E8F" />
                                            <Label Text="{Binding DateLogged, StringFormat='{0:hh:mm tt}'}" FontSize="11" TextColor="#7E7E8F" />
                                            <Label Text="•" FontSize="11" TextColor="#7E7E8F" />
                                            <Label Text="{Binding Protein, StringFormat='P: {0:F0}g'}" FontSize="11" TextColor="#6C4AB6" />
                                            <Label Text="{Binding Carbs, StringFormat='C: {0:F0}g'}" FontSize="11" TextColor="#4CAF50" />
                                            <Label Text="{Binding Fat, StringFormat='F: {0:F0}g'}" FontSize="11" TextColor="#FF9800" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                        <Label Text="{Binding Calories, StringFormat='{0:F0} kcal'}" FontSize="14" FontAttributes="Bold" TextColor="#F06292" VerticalOptions="Center" />
                                        <ImageButton Source="dotnet_bot.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DietSummaryViewModel}}, Path=DeleteLogEntryCommand}"
                                                     CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Action Button at the Bottom Center/Right -->
        <Button Grid.Row="2" 
                Text="+ Log New Food" 
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                BackgroundColor="#F06292"
                CornerRadius="25"
                HeightRequest="50"
                WidthRequest="220"
                HorizontalOptions="Center"
                Margin="0,10,0,20"
                Command="{Binding NavigateToLogFoodCommand}" />
    </Grid>
</ContentPage>
