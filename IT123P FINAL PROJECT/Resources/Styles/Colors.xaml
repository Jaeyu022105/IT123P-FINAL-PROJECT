<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- FoodLens palette: warm paper, leafy greens, and produce-inspired accents. -->
    <Color x:Key="Canvas">#F4F1E8</Color>
    <Color x:Key="Surface">#FFFCF5</Color>
    <Color x:Key="SurfaceMuted">#ECE9DE</Color>
    <Color x:Key="Border">#D8DCCD</Color>
    <Color x:Key="TextPrimary">#263329</Color>
    <Color x:Key="TextMuted">#68766A</Color>
    <Color x:Key="TextSubtle">#8B968B</Color>

    <Color x:Key="Forest">#315C3A</Color>
    <Color x:Key="ForestDark">#203E27</Color>
    <Color x:Key="Leaf">#5E8C4A</Color>
    <Color x:Key="Sage">#B7C9A9</Color>
    <Color x:Key="SageLight">#E3EBDD</Color>

    <Color x:Key="Berry">#B9505A</Color>
    <Color x:Key="BerryLight">#F3D8D6</Color>
    <Color x:Key="Plum">#725A7A</Color>
    <Color x:Key="PlumLight">#E6DDE8</Color>
    <Color x:Key="Sky">#4E7891</Color>
    <Color x:Key="SkyLight">#D7E5EA</Color>
    <Color x:Key="Harvest">#C7952C</Color>
    <Color x:Key="HarvestLight">#F4E6BB</Color>
    <Color x:Key="Earth">#76553A</Color>
    <Color x:Key="EarthLight">#EBDCCB</Color>
    <Color x:Key="Danger">#A8463C</Color>
    <Color x:Key="Overlay">#800E1D13</Color>
    <Color x:Key="Glass">#33FFFCF5</Color>
    <Color x:Key="Viewfinder">#1E2B22</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <!-- Compatibility aliases used by MAUI's shared control styles. -->
    <Color x:Key="Primary">#315C3A</Color>
    <Color x:Key="PrimaryDark">#B7C9A9</Color>
    <Color x:Key="PrimaryDarkText">#203E27</Color>
    <Color x:Key="Secondary">#E3EBDD</Color>
    <Color x:Key="SecondaryDarkText">#5E8C4A</Color>
    <Color x:Key="Tertiary">#725A7A</Color>
    <Color x:Key="Black">#263329</Color>
    <Color x:Key="MidnightBlue">#203E27</Color>
    <Color x:Key="OffBlack">#263329</Color>
    <Color x:Key="Gray100">#ECE9DE</Color>
    <Color x:Key="Gray200">#D8DCCD</Color>
    <Color x:Key="Gray300">#B7C0B4</Color>
    <Color x:Key="Gray400">#8B968B</Color>
    <Color x:Key="Gray500">#68766A</Color>
    <Color x:Key="Gray600">#465448</Color>
    <Color x:Key="Gray900">#263329</Color>
    <Color x:Key="Gray950">#203E27</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
